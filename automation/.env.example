# =============================================================================
# JAS Studios — WhatsApp Lead Automation
# Environment variables for n8n
# =============================================================================
#
# HOW TO USE:
#  - If self-hosting n8n: copy this file to `.env` next to your docker-compose.yml
#    or export the vars in the shell that runs n8n.
#  - If using n8n Cloud: open Settings → Variables and add each one.
#  - Inside the workflow they are referenced as: {{$env.VAR_NAME}}
#
# NEVER commit a real .env. Only commit this template.
# =============================================================================


# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# -----------------------------------------------------------------------------

# Permanent system-user access token (NOT the temporary 24h token).
# Generated in Meta Business → Business Settings → System users → Generate token.
# Required scopes: whatsapp_business_messaging, whatsapp_business_management.
WHATSAPP_TOKEN=EAAG...replace_me

# The phone-number ID (NOT the phone number itself) used to send messages.
# Find it in Meta Developer Console → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Business Account ID — used for some management endpoints (optional but useful).
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765

# A random string YOU pick. Meta echoes it back during the GET handshake to
# prove the webhook is yours. Use a long random value (e.g. `openssl rand -hex 24`).
WHATSAPP_VERIFY_TOKEN=replace_with_long_random_string

# App Secret from Meta Developer Console → App Settings → Basic.
# Used to verify the X-Hub-Signature-256 HMAC on every incoming POST.
WHATSAPP_APP_SECRET=replace_me_app_secret

# Pin the Graph API version. Required by the project: v25.0.
WHATSAPP_GRAPH_VERSION=v25.0


# -----------------------------------------------------------------------------
# Admin / notification targets
# -----------------------------------------------------------------------------

# E.164 number (no +, no spaces) that receives the lead-summary WhatsApp DM.
# Example: 919876543210 for an Indian number.
ADMIN_PHONE=919999999999

# Email address that receives the lead-summary email + error alerts.
ADMIN_EMAIL=admin@jasstudios.com

# Display name in outgoing emails.
ADMIN_FROM_NAME=JAS Studios Bot


# -----------------------------------------------------------------------------
# Google Sheets — single sheet, two tabs: `Leads` and `Sessions`
# -----------------------------------------------------------------------------

# The spreadsheet ID (NOT the sheet/tab ID).
# It's the long string in the URL between /d/ and /edit.
LEADS_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789ABCDEFG

# Tab names — keep these defaults unless you renamed the tabs.
LEADS_SHEET_TAB=Leads
SESSIONS_SHEET_TAB=Sessions


# -----------------------------------------------------------------------------
# Google Drive
# -----------------------------------------------------------------------------

# Folder ID of the parent "JAS Leads" folder. Per-lead subfolders
# (named YYYY-MM-DD_Name_Service) are created inside it.
GDRIVE_ROOT_FOLDER_ID=0ABcD-1EfGhIjKlMnOpQrSt


# -----------------------------------------------------------------------------
# OpenAI (optional — used for free-text fallback / human-handoff drafts)
# -----------------------------------------------------------------------------

# Leave empty to disable the AI assistant branch.
OPENAI_API_KEY=

# Model used for the assistant. gpt-4o-mini is a good cost/quality default.
OPENAI_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# n8n internal
# -----------------------------------------------------------------------------

# Workflow ID of the imported `jas-studios-error-handler.json`.
# After importing it once, copy the ID from the URL and paste it here.
ERROR_HANDLER_WORKFLOW_ID=

# Public base URL of your n8n instance (no trailing slash). Used in admin emails.
# e.g. https://n8n.jasstudios.com
N8N_PUBLIC_URL=https://n8n.example.com
