  "empty_event": {
    "_note": "Some test webhooks Meta sends — bare entry with no value. Workflow's defensive parsing handles this gracefully.",
    "object": "whatsapp_business_account",
    "entry": [
      {
        "id": "WABA_ID",
        "changes": [{ "field": "messages", "value": { "messaging_product": "whatsapp" } }]
      }
    ]
  },

  "completely_empty_body": {
    "_note": "Curl an empty {} to your webhook. Workflow returns 200 OK and does nothing.",
    "_payload": {}
  },

  "voice_note_unsupported": {
    "_note": "WhatsApp lets users send voice notes. The bot doesn't handle them yet (audio is treated as media, downloaded, but the State Machine has no transcription step). Useful for testing graceful handling.",
    "object": "whatsapp_business_account",
    "entry": [
      {
        "id": "WABA_ID",
        "changes": [
          {
            "field": "messages",
            "value": {
              "messaging_product": "whatsapp",
              "metadata": {
                "display_phone_number": "15550199999",
                "phone_number_id": "PHONE_NUMBER_ID"
              },
              "contacts": [{ "profile": { "name": "Vijay McKenna" }, "wa_id": "919876543210" }],
              "messages": [
                {
                  "from": "919876543210",
                  "id": "wamid.HBgMOTE5ODc2NTQzMjEwFQIAEhggMzREN0Y3RkE0NTI3RkRBQzlGAJ==",
                  "timestamp": "1747740500",
                  "type": "audio",
                  "audio": {
                    "id": "5555555555555555",
                    "mime_type": "audio/ogg; codecs=opus",
                    "sha256": "voice...",
                    "voice": true
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },

