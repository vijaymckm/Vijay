  "status_delivered": {
    "_note": "Sent automatically by Meta after every outbound message reaches the user. Should NOT trigger a bot reply. Workflow short-circuits at IF isMessage -> false -> Respond 200.",
    "object": "whatsapp_business_account",
    "entry": [
      {
        "id": "WABA_ID",
        "changes": [
          {
            "field": "messages",
            "value": {
              "messaging_product": "whatsapp",
              "metadata": {
                "display_phone_number": "15550199999",
                "phone_number_id": "PHONE_NUMBER_ID"
              },
              "statuses": [
                {
                  "id": "wamid.HBgMOTE5ODc2NTQzMjEwFQIAEhggMzREN0Y3RkE0NTI3RkRBQzlGAF==",
                  "status": "delivered",
                  "timestamp": "1747740300",
                  "recipient_id": "919876543210",
                  "conversation": {
                    "id": "conv_abc123",
                    "origin": { "type": "user_initiated" }
                  },
                  "pricing": {
                    "billable": true,
                    "pricing_model": "CBP",
                    "category": "user_initiated"
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },

