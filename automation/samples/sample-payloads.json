{
  "_README": "Real-shape examples of WhatsApp Cloud API webhook payloads (v25.0). Use these to test the workflow without hitting Meta. Replace 'PHONE_NUMBER_ID' / 'WABA_ID' / phone numbers with your own values when replaying. Top-level keys are scenario names; the object under each is the JSON body Meta would POST to your webhook. Use them with: curl -X POST <test-webhook-url> -H 'Content-Type: application/json' -d \"$(jq '.SCENARIO_NAME' samples/sample-payloads.json)\"",

  "text_message_hi": {
    "object": "whatsapp_business_account",
    "entry": [
      {
        "id": "WABA_ID",
        "changes": [
          {
            "field": "messages",
            "value": {
              "messaging_product": "whatsapp",
              "metadata": {
                "display_phone_number": "15550199999",
                "phone_number_id": "PHONE_NUMBER_ID"
              },
              "contacts": [
                {
                  "profile": { "name": "Vijay McKenna" },
                  "wa_id": "919876543210"
                }
              ],
              "messages": [
                {
                  "from": "919876543210",
                  "id": "wamid.HBgMOTE5ODc2NTQzMjEwFQIAEhggMzREN0Y3RkE0NTI3RkRBQzlGAA==",
                  "timestamp": "1747740000",
                  "type": "text",
                  "text": { "body": "hi" }
                }
              ]
            }
          }
        ]
      }
    ]
  },

