        "jsCode": "// Meta GET handshake. Echoes back hub.challenge IFF the verify token matches.\n// Docs: https://developers.facebook.com/docs/graph-api/webhooks/getting-started\nconst q = $input.first().json.query || {};\nconst expected = $env.WHATSAPP_VERIFY_TOKEN;\nif (q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === expected) {\n  return [{ json: { ok: true, challenge: String(q['hub.challenge'] ?? '') } }];\n}\nreturn [{ json: { ok: false, challenge: '' } }];"
      },
