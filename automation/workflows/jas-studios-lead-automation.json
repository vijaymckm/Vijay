    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// =====================================================================\n// State machine.\n// Inputs:\n//   $('Safe Parse + HMAC').first().json  -> incoming message fields\n//   $('Load Session').first().json       -> existing session row (may be empty {})\n// Outputs:\n//   reply, nextStep, leadComplete, isMedia, mediaId, lead{}\n// =====================================================================\nconst incoming = $('Safe Parse + HMAC').first().json;\nconst sessionRaw = ($('Load Session').first() && $('Load Session').first().json) || {};\nconst session = sessionRaw && sessionRaw.phone ? sessionRaw : {};\n\nconst phone = incoming.from || '';\nconst text  = (incoming.text || '').trim();\nconst type  = incoming.messageType || '';\nconst isMedia = !!incoming.mediaId;\nconst displayName = incoming.displayName || '';\n\nconst greetingRe = /^\\s*(hi+|hello+|hlo+|hai+|hey+|helo+|namaste|hola)\\s*[!.?]*$/i;\nconst restartRe  = /^\\s*(menu|restart|reset|start\\s*over)\\s*$/i;\nconst humanRe    = /^\\s*(human|agent|talk\\s*to\\s*human|representative|support)\\s*$/i;\nconst doneRe     = /^\\s*(done|finish|finished|that's all|thats all)\\s*$/i;\nconst skipRe     = /^\\s*(skip|none|no)\\s*$/i;\nconst yesRe      = /^\\s*(yes|y|yep|yeah|sure)\\s*$/i;\n\nconst SERVICES = {\n  '1': 'Branding',\n  '2': 'Web Design',\n  '3': 'Digital Marketing',\n  '4': 'Studio Rental'\n};\n\n// Steps the bot walks through\nconst STEPS = ['NEW','AWAIT_SERVICE','AWAIT_NAME','AWAIT_PHONE','AWAIT_BUSINESS','AWAIT_BUDGET','AWAIT_TIMELINE','AWAIT_DOCS','AWAIT_NOTES','DONE','HUMAN'];\n\nlet currentStep = (session.step && STEPS.includes(session.step)) ? session.step : 'NEW';\n\n// rebuild lead from session\nlet lead = {\n  phone,\n  displayName: session.displayName || displayName || '',\n  name:        session.name || '',\n  altPhone:    session.altPhone || '',\n  businessName:session.businessName || '',\n  service:     session.service || '',\n  budget:      session.budget || '',\n  timeline:    session.timeline || '',\n  notes:       session.notes || '',\n  fileLinks:   session.fileLinks || ''\n};\n\nlet reply = '';\nlet nextStep = currentStep;\nlet leadComplete = false;\nlet needHumanHandoff = false;\nlet useAiFallback = false;\n\n// Universal commands ---------------------------------------------------\nif (greetingRe.test(text) || restartRe.test(text)) {\n  currentStep = 'NEW';\n  // wipe partial answers but keep displayName\n  lead = { phone, displayName: lead.displayName, name:'', altPhone:'', businessName:'', service:'', budget:'', timeline:'', notes:'', fileLinks:'' };\n}\nif (humanRe.test(text)) {\n  needHumanHandoff = true;\n  nextStep = 'HUMAN';\n  reply = '👤 Connecting you to a human team member. Someone from JAS Studios will reach out shortly.\\n\\nType *menu* to return to the bot.';\n}\n\n// Main FSM ------------------------------------------------------------\nif (!needHumanHandoff) {\n  switch (currentStep) {\n    case 'NEW':\n      reply = `Welcome to *JAS Studios* 👋\\n\\nPlease choose a service:\\n*1.* Branding\\n*2.* Web Design\\n*3.* Digital Marketing\\n*4.* Studio Rental\\n\\nReply with the number (1-4).`;\n      nextStep = 'AWAIT_SERVICE';\n      break;\n\n    case 'AWAIT_SERVICE':\n      if (SERVICES[text]) {\n        lead.service = SERVICES[text];\n        reply = `Great choice — *${lead.service}* ✨\\n\\nWhat's your *full name*?`;\n        nextStep = 'AWAIT_NAME';\n      } else {\n        reply = `Please reply with a number from 1 to 4.\\n\\n*1.* Branding\\n*2.* Web Design\\n*3.* Digital Marketing\\n*4.* Studio Rental`;\n      }\n      break;\n\n    case 'AWAIT_NAME':\n      if (text.length >= 2 && text.length < 80) {\n        lead.name = text;\n        reply = `Thanks ${lead.name}! 🙌\\n\\nIs *+${phone}* the best number to reach you on?\\nReply *yes* — or share your preferred phone number.`;\n        nextStep = 'AWAIT_PHONE';\n      } else {\n        reply = `Please share your full name (2-80 characters).`;\n      }\n      break;\n\n    case 'AWAIT_PHONE':\n      lead.altPhone = yesRe.test(text) ? phone : text;\n      reply = `Got it 📞\\n\\nWhat's your *business / brand name*?\\n_(Reply *NA* if you don't have one yet.)_`;\n      nextStep = 'AWAIT_BUSINESS';\n      break;\n\n    case 'AWAIT_BUSINESS':\n      lead.businessName = /^\\s*na\\s*$/i.test(text) ? '' : text;\n      reply = `Awesome.\\n\\nWhat's your *budget* range for this project?\\n_(e.g. ₹25,000 / $500-$1000)_`;\n      nextStep = 'AWAIT_BUDGET';\n      break;\n\n    case 'AWAIT_BUDGET':\n      lead.budget = text;\n      reply = `Thanks!\\n\\nWhat's your *timeline*?\\n_(e.g. ASAP, 2 weeks, next month)_`;\n      nextStep = 'AWAIT_TIMELINE';\n      break;\n\n    case 'AWAIT_TIMELINE':\n      lead.timeline = text;\n      reply = `Almost done 🎯\\n\\nDo you have any *reference files* — images, PDFs, brand assets?\\nSend them now one by one.\\n\\nWhen you're done, reply *DONE* — or reply *SKIP* if you have none.`;\n      nextStep = 'AWAIT_DOCS';\n      break;\n\n    case 'AWAIT_DOCS':\n      if (isMedia) {\n        // file is uploaded by the downstream media branch; we just acknowledge here\n        reply = `📎 File received and saved to your project folder.\\n\\nSend more files, or reply *DONE* when finished.`;\n        nextStep = 'AWAIT_DOCS';\n      } else if (doneRe.test(text) || skipRe.test(text)) {\n        reply = `Anything else you'd like to add? (notes, special requests).\\nReply *NA* to skip.`;\n        nextStep = 'AWAIT_NOTES';\n      } else {\n        reply = `Please send a file (image / PDF / doc) — or reply *DONE* / *SKIP*.`;\n      }\n      break;\n\n    case 'AWAIT_NOTES':\n      lead.notes = /^\\s*na\\s*$/i.test(text) ? '' : text;\n      reply = `🎉 Thanks ${lead.name}! Your enquiry has been recorded.\\n\\nOur team will reach out within 24 hours.\\n\\nType *menu* anytime to start over, or *human* to talk to an agent.`;\n      nextStep = 'DONE';\n      leadComplete = true;\n      break;\n\n    case 'DONE':\n    case 'HUMAN':\n      // Free-form: optionally ask the OpenAI fallback to draft a reply\n      if ($env.OPENAI_API_KEY) {\n        useAiFallback = true;\n        reply = '';\n      } else {\n        reply = `Our team has your details and will be in touch soon. Type *menu* to start a new enquiry.`;\n      }\n      nextStep = currentStep;\n      break;\n\n    default:\n      reply = `Sorry, something went wrong. Type *menu* to start over.`;\n      nextStep = 'NEW';\n  }\n}\n\nreturn [{\n  json: {\n    // routing flags\n    isMedia,\n    leadComplete,\n    needHumanHandoff,\n    useAiFallback,\n    // raw incoming\n    phone,\n    text,\n    type,\n    mediaId: incoming.mediaId,\n    mediaMime: incoming.mediaMime,\n    mediaFilename: incoming.mediaFilename,\n    wamid: incoming.wamid,\n    // outputs\n    currentStep,\n    nextStep,\n    reply,\n    // composed lead\n    lead,\n    // for folder name: YYYY-MM-DD_Name_Service\n    folderName: `${new Date().toISOString().slice(0,10)}_${(lead.name || displayName || phone).replace(/[^a-zA-Z0-9_-]+/g,'-').slice(0,40)}_${(lead.service || 'General').replace(/[^a-zA-Z0-9_-]+/g,'-')}`\n  }\n}];"
      },
