      "id": "load-session",
      "name": "Load Session",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-620, 60],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GS_CRED_ID",
