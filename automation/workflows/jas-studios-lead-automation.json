    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// =====================================================================\n// 1) HMAC verify (X-Hub-Signature-256)\n// 2) Null-safe payload parse\n// 3) Decide isMessage / isStatus / isMedia\n// =====================================================================\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = (item.json.headers || {});\nconst body = item.json.body || {};\n\n// ---- HMAC verification (skipped if WHATSAPP_APP_SECRET not set) ----\nlet hmacOk = true;\nlet hmacReason = 'skipped';\nconst secret = $env.WHATSAPP_APP_SECRET;\nif (secret) {\n  hmacReason = 'failed';\n  // raw body is provided by the webhook node when options.rawBody = true\n  const raw = item.binary && item.binary.data\n    ? Buffer.from(item.binary.data.data, 'base64').toString('utf8')\n    : JSON.stringify(body);\n  const sig = headers['x-hub-signature-256'] || headers['X-Hub-Signature-256'] || '';\n  if (sig && sig.startsWith('sha256=')) {\n    const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n    try {\n      if (sig.length === expected.length &&\n          crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) {\n        hmacOk = true;\n        hmacReason = 'ok';\n      } else {\n        hmacOk = false;\n      }\n    } catch (e) {\n      hmacOk = false;\n      hmacReason = 'exception:' + e.message;\n    }\n  } else {\n    hmacOk = false;\n    hmacReason = 'missing-signature';\n  }\n}\n\n// ---- Null-safe payload extraction ----\nconst entry   = body && Array.isArray(body.entry) ? body.entry[0] : null;\nconst changes = entry && Array.isArray(entry.changes) ? entry.changes[0] : null;\nconst value   = changes && changes.value ? changes.value : null;\nconst msgs    = value && Array.isArray(value.messages) ? value.messages : [];\nconst statuses= value && Array.isArray(value.statuses) ? value.statuses : [];\nconst contacts= value && Array.isArray(value.contacts) ? value.contacts : [];\n\nconst msg = msgs[0] || null;\nconst isMessage = !!msg;\nconst isStatus  = !isMessage && statuses.length > 0;\n\n// Fields common to every message\nlet from         = msg ? String(msg.from || '') : '';\nlet wamid        = msg ? String(msg.id || '') : '';\nlet messageType  = msg ? String(msg.type || '') : '';\nlet timestamp    = msg ? Number(msg.timestamp || 0) * 1000 : Date.now();\nlet displayName  = (contacts[0] && contacts[0].profile && contacts[0].profile.name) || '';\n\n// Type-specific extraction\nlet text = '';\nlet mediaId = '';\nlet mediaMime = '';\nlet mediaFilename = '';\nif (msg) {\n  if (messageType === 'text') {\n    text = (msg.text && msg.text.body) ? String(msg.text.body) : '';\n  } else if (messageType === 'button') {\n    text = (msg.button && msg.button.text) ? String(msg.button.text) : '';\n  } else if (messageType === 'interactive') {\n    const i = msg.interactive || {};\n    text = (i.button_reply && i.button_reply.title) ||\n           (i.list_reply && i.list_reply.title) || '';\n  } else if (messageType === 'image' || messageType === 'document' || messageType === 'video' || messageType === 'audio') {\n    const m = msg[messageType] || {};\n    mediaId = String(m.id || '');\n    mediaMime = String(m.mime_type || '');\n    mediaFilename = String(m.filename || '');\n    text = String(m.caption || '');\n  }\n}\n\nconst isMedia = !!mediaId;\n\nreturn [{\n  json: {\n    hmacOk,\n    hmacReason,\n    isMessage,\n    isStatus,\n    isMedia,\n    from,\n    wamid,\n    timestamp,\n    displayName,\n    messageType,\n    text,\n    mediaId,\n    mediaMime,\n    mediaFilename\n  }\n}];"
      },
